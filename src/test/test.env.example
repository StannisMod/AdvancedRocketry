# Per-machine test tuning. Copy this file to `test.env` (in the same
# directory) and adjust the values below to match the host's CPU/RAM/GPU
# headroom. `test.env` itself is gitignored — each contributor maintains
# their own.
#
# Format: KEY=VALUE, one per line. Lines starting with `#` are comments.
# Whitespace around `=` and at line ends is trimmed.
#
# Precedence: a Gradle `-P<key>=<value>` flag on the command line ALWAYS
# overrides whatever `test.env` says. So CI can pass explicit values and
# ignore local files entirely.

# ── Parallelism ──────────────────────────────────────────────────────────
#
# Number of parallel JVMs Gradle spawns for the client e2e harness
# (`testClient`). Each fork launches a real Minecraft client + dedicated
# server pair — budget ~1.5 GB RAM and one GL context per fork. The
# framework randomises TCP ports and workdirs, so concurrent forks don't
# collide, but the host's GL driver (especially Intel iGPU) can melt down
# under contention. Start low (1–2) on laptops; 4–8 is fine on a desktop
# with a dGPU and 32+ GB RAM. Default if absent: 1.
clientForks=2

# Number of parallel JVMs for the headless-server harness layer
# (`testServer`). Cheaper per fork than client (no GL), so this can go
# higher. Default if absent: 3.
forks=3

# ── Weather mode ────────────────────────────────────────────────────────
#
# Expected weather mode for the weather baseline tests. Default
# `per_dimension` matches the B1 wrapper that's now standard. Flip to
# `shared` only when bisecting whether the wrap silently regressed.
weather=per_dimension
